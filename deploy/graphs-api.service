[Unit]
Description=IISG per-pipeline graph download API (stdlib http.server, behind Caddy)
After=network.target

[Service]
Type=simple
User=silk
Group=silk
WorkingDirectory=/home/silk/pipelines/iisg-kg-etl
ExecStart=/usr/bin/python3 /home/silk/pipelines/iisg-kg-etl/api.py \
    --output-dir /home/silk/triplestore/sources \
    --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
